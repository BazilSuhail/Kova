{
  "expo": {
    "name": "zenflow",
    "slug": "zenflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zenflow",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow ZenFlow to transcribe your speech to text.",
        "NSMicrophoneUsageDescription": "Allow ZenFlow to use the microphone for interviews."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.anonymous.zenflow"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow ZenFlow to use the microphone for interviews.",
          "speechRecognitionPermission": "Allow ZenFlow to transcribe your speech to text."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "e7727eb1-aca1-4a32-b5c4-9cb00ad5a45b"
      }
    },
    "owner": "bazil_suhail"
  }
}
